#!/usr/bin/env bash
# ==============================================================================
# Lanzador de escritorio para macOS (Apple Silicon M1/M2/M3/M4 & Intel)
# Permite iniciar MySQL IDE & Debugger con doble clic desde el Finder
# ==============================================================================

# Ir a la carpeta donde se encuentra este archivo
cd "$(dirname "$0")"

# Ejecutar el script principal de inicio
bash ./run.sh

